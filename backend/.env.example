# PDPV Tickets - Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit .env with real values!

# MongoDB connection string (REQUIRED)
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=test_database

# CORS origins (comma-separated or *)
CORS_ORIGINS=*

# JWT Secret for token signing (REQUIRED - min 32 chars recommended)
JWT_SECRET=

# Frontend URL for email links
FRONTEND_URL=http://localhost:3000

# Web Push VAPID Keys (auto-generated if not provided)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

# Resend API Key for email sending (optional)
RESEND_API_KEY=

# Email from address (requires verified domain in Resend)
EMAIL_FROM=
